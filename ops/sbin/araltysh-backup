#!/bin/bash
set -euo pipefail
umask 077
mkdir -p /var/backups/araltysh
chmod 700 /var/backups/araltysh
file="/var/backups/araltysh/db-$(date -u +%Y%m%dT%H%M%SZ).dump"
runuser -u postgres -- pg_dump -Fc -d araltysh > "$file.tmp"
pg_restore --list "$file.tmp" >/dev/null
mv "$file.tmp" "$file"
mapfile -t files < <(find /var/backups/araltysh -maxdepth 1 -type f -name 'db-*.dump' | sort -r)
for ((i=2;i<${#files[@]};i++)); do rm -- "${files[$i]}"; done
